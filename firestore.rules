rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS & AUTH CONTEXT
    // ==========================================
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myEmail() {
      return signedIn() && request.auth.token.email != null ? request.auth.token.email : '';
    }

    // Emergency owner account strictly for initial bootstrap/migration safety
    function isEmergencyOwnerEmail() {
      return signedIn() && myEmail() == 'dgtfamilyyt8@gmail.com';
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function myRole() {
      return hasProfile() ? getUserProfile().role : '';
    }

    function isAccountActive() {
      return hasProfile() && (!('isActive' in getUserProfile()) || getUserProfile().isActive == true);
    }

    function isStaff() {
      return signedIn() && isAccountActive() && (myRole() in ['trainer', 'admin', 'owner']);
    }

    function isTrainer() {
      return signedIn() && isAccountActive() && myRole() == 'trainer';
    }

    function isAdmin() {
      return signedIn() && isAccountActive() && myRole() == 'admin';
    }

    function isOwner() {
      return signedIn() && isAccountActive() && myRole() == 'owner';
    }

    function isAdminOrOwner() {
      return signedIn() && isAccountActive() && (myRole() in ['admin', 'owner']);
    }

    // Dedicated bootstrap helper for emergency owner to perform initial provisioning only
    // Requires BOTH gym document missing AND verified emergency owner email
    function isBootstrap() {
      return !exists(/databases/$(database)/documents/gyms/infinity-neelambur) && isEmergencyOwnerEmail();
    }

    // Health check endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // ==========================================
    // 1. GYM CONFIGURATION & CMS (Public Read)
    // ==========================================
    match /gyms/{gymId} {
      allow read: if true;
      allow write: if isAdminOrOwner() || (isBootstrap() && gymId == 'infinity-neelambur');
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'whatsapp', 'altPhone', 'updatedAt']);
    }

    // ==========================================
    // 2. GYM FLOOR ZONES & OCCUPANCY
    // ==========================================
    match /gym_zones/{zoneId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // 3. MEMBERSHIP PLANS (Public Read)
    // ==========================================
    match /membership_plans/{planId} {
      allow read: if true;
      allow write: if isAdminOrOwner();
    }

    // ==========================================
    // 3b. PUBLIC TRAINERS (Public Read)
    // ==========================================
    match /public_trainers/{trainerId} {
      // Public read access for active trainer cards; staff can view all trainer cards
      allow read: if (resource == null || resource.data.isPublic == true) || isStaff();
      // Write access restricted exclusively to admin or owner (publishing boundary)
      allow write: if isAdminOrOwner();
    }

    // ==========================================
    // 4. USER PROFILES
    // ==========================================
    match /profiles/{userId} {
      // Direct self-read for authenticated user: strictly allows reading own document
      // Evaluated first so self-read never fails on missing doc or staff recursion
      // Profiles are private: public and non-staff reads are blocked
      allow read: if (request.auth != null && request.auth.uid == userId)
                  || isStaff();

      allow create: if signedIn() && (
        isAdminOrOwner() || 
        isStaff() || 
        // Initial emergency bootstrap: allows emergency owner to provision initial owner profile only when gym is unseeded
        (
          isBootstrap() &&
          myUid() == userId &&
          request.resource.data.role == 'owner' &&
          request.resource.data.gymId == 'infinity-neelambur' &&
          request.resource.data.isActive == true &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.authLinked == true &&
          request.auth.token.email != null &&
          request.resource.data.email == request.auth.token.email
        ) ||
        // Strict temporary safe client-side member profile creation (Requirements 1, 2, 3)
        (
          myUid() == userId &&
          request.resource.data.role == 'member' &&
          request.resource.data.gymId == 'infinity-neelambur' &&
          request.resource.data.isActive == true &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.authLinked == true &&
          request.auth.token.email != null &&
          request.resource.data.email == request.auth.token.email
        )
      );

      allow update: if signedIn() && (
        isAdminOrOwner() ||
        // Normal self-update for own profile: cannot modify privileged, structural, or link fields (Requirement 4)
        (myUid() == userId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'status', 'isActive', 'memberId', 'qrToken', 
            'membershipPlanId', 'planName', 'membershipStart', 'membershipExpiry', 
            'assignedTrainerId', 'gymId', 'authUid', 'authLinked'
          ])
        )) ||
        // Controlled initial linking of member pre-registration document (Requirements 4, 7)
        (
          resource.data.role == 'member' &&
          request.auth.token.email != null &&
          resource.data.email == request.auth.token.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'authLinked', 'updatedAt']) &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.authLinked == true &&
          (!('authLinked' in resource.data) || resource.data.authLinked != true)
        )
      );

      allow delete: if isAdminOrOwner();
    }

    // ==========================================
    // 5. MEMBERSHIPS
    // ==========================================
    match /memberships/{membershipId} {
      allow read: if signedIn() && (resource.data.memberUid == myUid() || isStaff());
      allow write: if isAdminOrOwner();
    }

    // ==========================================
    // 6. QR ACCESS TOKENS (Doc ID = SHA-256 hash)
    // ==========================================
    match /qr_tokens/{tokenHash} {
      allow read: if signedIn() && (isStaff() || (resource.data.memberUid == myUid()));
      allow write: if isStaff();
    }

    // ==========================================
    // 7. ACTIVE GYM FLOOR SESSIONS
    // ==========================================
    match /active_gym_sessions/{sessionId} {
      allow read: if signedIn() && (
        isStaff() || 
        resource.data.memberUid == myUid() || 
        resource.data.memberId == myUid() ||
        sessionId == myUid()
      );
      allow write: if isStaff();
    }

    // ==========================================
    // 8. ATTENDANCE RECORDS (Historical Logs)
    // ==========================================
    match /attendance_records/{recordId} {
      allow read: if signedIn() && (
        isStaff() || 
        resource.data.memberUid == myUid() || 
        resource.data.memberId == myUid()
      );
      allow write: if isStaff();
    }

    // ==========================================
    // 9. WORKOUT ASSIGNMENTS
    // ==========================================
    match /workout_assignments/{assignmentId} {
      allow read: if signedIn() && (
        isStaff() || 
        resource.data.memberId == myUid() || 
        resource.data.memberUid == myUid() ||
        (hasProfile() && resource.data.memberId == getUserProfile().memberId)
      );

      allow create: if isStaff() || (
        signedIn() && (
          request.resource.data.memberId == myUid() || 
          request.resource.data.memberUid == myUid() ||
          (hasProfile() && request.resource.data.memberId == getUserProfile().memberId)
        )
      );

      allow update: if signedIn() && (
        isStaff() || 
        resource.data.memberId == myUid() || 
        resource.data.memberUid == myUid() ||
        (hasProfile() && resource.data.memberId == getUserProfile().memberId)
      );

      allow delete: if isAdminOrOwner();
    }

    // ==========================================
    // 10. WORKOUT OVERRIDES
    // ==========================================
    match /workout_overrides/{overrideId} {
      allow read: if signedIn() && (
        isStaff() || 
        resource.data.memberId == myUid()
      );
      allow create: if isStaff();
      allow update, delete: if isAdminOrOwner();
    }

    // ==========================================
    // 11. FINANCIAL PAYMENTS (Immutable)
    // ==========================================
    match /payments/{paymentId} {
      allow read: if signedIn() && (
        isAdminOrOwner() || 
        resource.data.memberId == myUid()
      );
      allow create: if isAdminOrOwner();
      allow update, delete: if false;
    }

    // ==========================================
    // 12. PERSONAL RECORDS (PRs)
    // ==========================================
    match /personal_records/{prId} {
      allow read: if signedIn() && (
        isStaff() || 
        resource.data.memberId == myUid()
      );
      allow create, update: if isStaff();
      allow delete: if isAdminOrOwner();
    }

    // ==========================================
    // 13. NOTIFICATIONS
    // ==========================================
    match /notifications/{notifId} {
      allow read: if signedIn() && (
        resource.data.userId == myUid() || 
        resource.data.memberId == myUid() ||
        isStaff()
      );
      allow write: if isStaff();
    }

    // ==========================================
    // 14. AUDIT LOGS (Append-Only)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isAdminOrOwner();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ==========================================
    // 15. PRE-REGISTRATION LINKS (Minimal Lookup)
    // ==========================================
    match /pre_registration_links/{emailHash} {
      // Authenticated user can read ONLY their own pre-registration link
      // Staff can also read
      allow read: if isStaff() || (
        signedIn() && 
        resource != null && 
        request.auth.token.email != null &&
        resource.data.emailNormalized == request.auth.token.email
      );

      // Staff can create pre-registration links
      allow create: if isStaff();

      // Authenticated user can link their own UID, or staff can update
      allow update: if isStaff() || (
        signedIn() &&
        request.auth.token.email != null &&
        resource.data.emailNormalized == request.auth.token.email &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.authLinked == true &&
        (!('authLinked' in resource.data) || resource.data.authLinked != true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'authLinked', 'updatedAt'])
      );

      allow delete: if isAdminOrOwner();
    }

    // ==========================================
    // 16. DEFAULT DENY CATCH-ALL
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
